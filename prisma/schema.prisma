// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  plastico
  papel
  organico
  general
}

model PrizeCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  color       String @default("#3b82f6")
  
  prizes Prize[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([name])
}

model TrashPoint {
  id             String   @id
  name           String
  lat            Float
  lng            Float
  detectedObject String
  detectedImage  String
  category       Category?
  fillLevel      Int
  lastCollected  String
  alert          String?

  todayStats      TodayStats?
  historicalStats HistoricalStats[]
}

model TodayStats {
  id         Int    @id @default(autoincrement())
  plastico   Int
  papel      Int
  organico   Int
  general    Int

  trashPoint   TrashPoint @relation(fields: [trashPointId], references: [id], onDelete: Cascade)
  trashPointId String     @unique
}

model HistoricalStats {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  plastico   Int      @default(0)
  papel      Int      @default(0)
  organico   Int      @default(0)
  general    Int      @default(0)

  trashPoint   TrashPoint @relation(fields: [trashPointId], references: [id], onDelete: Cascade)
  trashPointId String

  @@unique([trashPointId, date])
  @@index([date])
}

model Student {
  boleta          String @id
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ecoPoints       Int    @default(0)
  classifications Int    @default(0)
  level           String @default("Principiante")

  classifications_records ClassificationRecord[]
  eco_point_transactions  EcoPointTransaction[]
  prize_redemptions       PrizeRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prize {
  id          String @id
  name        String @unique
  description String
  cost        Int
  icon        String
  
  categoryId String
  category   PrizeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  redemptions PrizeRedemption[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([categoryId])
}

model ClassificationRecord {
  id            String @id @default(cuid())
  studentId     String
  student       Student @relation(fields: [studentId], references: [boleta], onDelete: Cascade)
  
  category      Category
  isCorrect     Boolean
  predictedAs   String?
  selectedAs    String?
  confidence    Float? // AI model confidence score
  
  trashPointId  String?
  
  createdAt DateTime @default(now())
  
  @@index([studentId])
  @@index([createdAt])
}

model EcoPointTransaction {
  id          String @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [boleta], onDelete: Cascade)
  
  type        String // "classification", "redemption", "admin_adjustment"
  amount      Int    // Can be negative for redemptions
  source      String? // classification_id, redemption_id, admin_reason
  
  balanceBefore Int
  balanceAfter  Int
  
  createdAt DateTime @default(now())
  
  @@index([studentId])
  @@index([type])
  @@index([createdAt])
}

model PrizeRedemption {
  id          String @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [boleta], onDelete: Cascade)
  
  prizeId     String
  prize       Prize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  
  qrCode      String @unique // Generated unique code
  qrImageUrl  String? // Data URL or file path to generated QR image
  
  status      String @default("active") // active, claimed, expired
  
  expiresAt   DateTime // Fixed 24 hours from creation
  claimedAt   DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([studentId])
  @@index([status])
  @@index([expiresAt])
}

model PolygonArea {
  id          String @id
  name        String
  color       String
  description String?

  points PolygonPoint[]
}

model PolygonPoint {
  id     Int    @id @default(autoincrement())
  lat    Float
  lng    Float

  area   PolygonArea @relation(fields: [areaId], references: [id])
  areaId String
}

// Models for authentication
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          String          @default("student") // "student" or "admin"
  accounts      Account[]
  sessions      Session[]
  student       Student?
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}